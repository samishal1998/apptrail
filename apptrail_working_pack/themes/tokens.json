{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "accent": "#ff7a2f",
    "accentStrong": "#ff5f2a",
    "accentSoft": "#ffb15c"
  },
  "dark": {
    "bg": "#0b1220",
    "bgElevated": "#101a2b",
    "panel": "rgba(16, 26, 43, 0.84)",
    "panelStrong": "#111c2d",
    "border": "rgba(255, 255, 255, 0.09)",
    "text": "#f7f8fb",
    "textMuted": "#aeb8ca",
    "textFaint": "#768398",
    "success": "#24c978",
    "warning": "#f4b21a",
    "danger": "#f45b69"
  },
  "light": {
    "bg": "#f4f7fb",
    "bgElevated": "#ffffff",
    "panel": "rgba(255, 255, 255, 0.88)",
    "panelStrong": "#ffffff",
    "border": "rgba(18, 31, 52, 0.10)",
    "text": "#111827",
    "textMuted": "#667085",
    "textFaint": "#98a2b3",
    "success": "#16a163",
    "warning": "#d99b0b",
    "danger": "#d84655"
  },
  "radius": {
    "control": "10px",
    "card": "16px",
    "panel": "20px",
    "pill": "999px"
  },
  "shadow": {
    "cardDark": "0 18px 50px rgba(0, 0, 0, 0.24)",
    "cardLight": "0 18px 50px rgba(38, 51, 77, 0.10)"
  }
}
